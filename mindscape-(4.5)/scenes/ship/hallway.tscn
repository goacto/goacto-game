[node name="HBox" type="HBoxContainer" parent="Header/Margin"]
layout_mode = 2

[node name="LocationLabel" type="Label" parent="Header/Margin/HBox"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_font_sizes/font_size = 20
theme_override_colors/font_color = Color(0.5, 0.45, 0.6, 1)
text = "Hallway - Stellar Wanderer"

[node name="MenuButton" type="Button" parent="Header/Margin/HBox"]
custom_minimum_size = Vector2(100, 40)
layout_mode = 2
theme_override_font_sizes/font_size = 18
text = "Menu"

[node name="InteractionPrompt" type="PanelContainer" parent="."]
visible = false
layout_mode = 1
anchors_preset = 7
anchor_left = 0.5
anchor_top = 1.0
anchor_right = 0.5
anchor_bottom = 1.0
offset_left = -150.0
offset_top = -120.0
offset_right = 150.0
offset_bottom = -60.0
grow_horizontal = 2
grow_vertical = 0

[node name="Margin" type="MarginContainer" parent="InteractionPrompt"]
layout_mode = 2
theme_override_constants/margin_left = 15
theme_override_constants/margin_top = 10
theme_override_constants/margin_right = 15
theme_override_constants/margin_bottom = 10

[node name="VBox" type="VBoxContainer" parent="InteractionPrompt/Margin"]
layout_mode = 2
theme_override_constants/separation = 5

[node name="ObjectName" type="Label" parent="InteractionPrompt/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 16
text = "Object Name"
horizontal_alignment = 1

[node name="PromptText" type="Label" parent="InteractionPrompt/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "Press SPACE to interact"
horizontal_alignment = 1

[node name="ControlHints" type="HBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 7
anchor_left = 0.5
anchor_top = 1.0
anchor_right = 0.5
anchor_bottom = 1.0
offset_left = -100.0
offset_top = -40.0
offset_right = 100.0
offset_bottom = -15.0
grow_horizontal = 2
grow_vertical = 0
alignment = 1

[node name="MoveHint" type="Label" parent="ControlHints"]
layout_mode = 2
theme_override_font_sizes/font_size = 12
text = "WASD/Arrows: Move"

[node name="DialoguePanel" type="PanelContainer" parent="."]
visible = false
layout_mode = 1
anchors_preset = 5
anchor_left = 0.5
anchor_right = 0.5
offset_left = -250.0
offset_top = 100.0
offset_right = 250.0
offset_bottom = 300.0
grow_horizontal = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_dialogue")

[node name="Margin" type="MarginContainer" parent="DialoguePanel"]
layout_mode = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 15
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 15

[node name="VBox" type="VBoxContainer" parent="DialoguePanel/Margin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="DialogueTitle" type="Label" parent="DialoguePanel/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Speaker"
horizontal_alignment = 1

[node name="DialogueText" type="Label" parent="DialoguePanel/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "Dialogue text goes here..."
horizontal_alignment = 1
autowrap_mode = 2

[node name="DialogueButton" type="Button" parent="DialoguePanel/Margin/VBox"]
layout_mode = 2
size_flags_horizontal = 4
text = "Continue"
