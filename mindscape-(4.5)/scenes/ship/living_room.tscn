grow_horizontal = 2
theme_override_styles/panel = SubResource("StyleBoxFlat_dialogue")

[node name="Margin" type="MarginContainer" parent="DialoguePanel"]
layout_mode = 2
theme_override_constants/margin_left = 20
theme_override_constants/margin_top = 15
theme_override_constants/margin_right = 20
theme_override_constants/margin_bottom = 15

[node name="VBox" type="VBoxContainer" parent="DialoguePanel/Margin"]
layout_mode = 2
theme_override_constants/separation = 10

[node name="DialogueTitle" type="Label" parent="DialoguePanel/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 20
text = "Speaker"
horizontal_alignment = 1

[node name="DialogueText" type="Label" parent="DialoguePanel/Margin/VBox"]
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "Dialogue text goes here..."
horizontal_alignment = 1
autowrap_mode = 2

[node name="DialogueButton" type="Button" parent="DialoguePanel/Margin/VBox"]
layout_mode = 2
size_flags_horizontal = 4
text = "Continue"
