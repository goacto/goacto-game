; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[animation]

compatibility/default_parent_skeleton_in_mesh_instance_3d=true

[application]

config/name="Mindscape"
config/description="Grow your inner world through real-world action"
config/version="0.1.0"
run/main_scene="res://scenes/main_menu/main_menu.tscn"
config/features=PackedStringArray("4.6", "Mobile")
config/icon="res://assets/sprites/ui/icon.png"

[audio]

buses/default_bus_layout="res://resources/audio_bus_layout.tres"

[autoload]

ThemeConfig="*res://autoload/ThemeConfig.gd"
CampaignManager="*res://autoload/CampaignManager.gd"
GameManager="*res://autoload/GameManager.gd"
HabitManager="*res://autoload/HabitManager.gd"
GoalManager="*res://autoload/GoalManager.gd"
ScriptManager="*res://autoload/ScriptManager.gd"
SaveManager="*res://autoload/SaveManager.gd"
MindscapeRegionManager="*res://autoload/MindscapeRegionManager.gd"
ChallengeManager="*res://autoload/ChallengeManager.gd"
AchievementManager="*res://autoload/AchievementManager.gd"
AudioManager="*res://autoload/AudioManager.gd"
TransitionManager="*res://autoload/TransitionManager.gd"
ShopManager="*res://autoload/ShopManager.gd"
CustomizationManager="*res://autoload/CustomizationManager.gd"
MailManager="*res://autoload/MailManager.gd"
RelationshipManager="*res://autoload/RelationshipManager.gd"

[display]

window/size/viewport_width=1366
window/size/viewport_height=768
window/size/window_width_override=1366
window/size/window_height_override=768
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

